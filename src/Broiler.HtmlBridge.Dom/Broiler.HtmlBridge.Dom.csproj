<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.HtmlBridge</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>DOM bridge, HTML tree building, and JavaScript DOM object integration for HtmlBridge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 3 work item 6: content-rendering polyfill JavaScript as a versioned embedded asset
         (externalized from inline C# string literals in DomBridge/Registration/Registration.cs). -->
    <!-- And ReadableStream, ProgressEvent and FileReader, JavaScript for the same reason the
         specification is: the stream is a state machine over promises. Each script is split across
         several files that PolyfillAssets joins back into one; the logical names are the file names. -->
    <EmbeddedResource Include="Polyfills\*.js">
      <LogicalName>Broiler.HtmlBridge.Polyfills.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler" />
    <InternalsVisibleTo Include="Broiler.Browser.Core" />
    <InternalsVisibleTo Include="Broiler.Browser.Core.Tests" />
    <!-- This component's own suite, which is where the bridge tests moved when the bridge
         left Broiler.Browser. The grant above stays: the browser keeps the tests that need
         its own host (page loading, the UI form controls, the render list). -->
    <InternalsVisibleTo Include="Broiler.HtmlBridge.Tests" />
    <InternalsVisibleTo Include="Broiler.HtmlBridge.Scripting" />
    <InternalsVisibleTo Include="Broiler.Cli" />
    <InternalsVisibleTo Include="Broiler.Cli.Tests" />
    <InternalsVisibleTo Include="Broiler.Engines.Baseline" />
    <InternalsVisibleTo Include="Broiler.DevConsole" />
    <InternalsVisibleTo Include="Broiler.DevConsole.Tests" />
    <InternalsVisibleTo Include="Broiler.Wpt" />
    <InternalsVisibleTo Include="Broiler.Wpt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.JavaScript.Modules" Version="0.1.0-preview.1" />
    <PackageReference Include="Broiler.JSeal" Version="0.1.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.HtmlBridge.Core\Broiler.HtmlBridge.Core.csproj" />
    <!-- DomBridgeUtils: the bridge's static helpers that need no bridge instance. The ones that do stay here
         as DomBridgeHostUtils. -->
    <ProjectReference Include="..\Broiler.HtmlBridge.DomBridgeUtils\Broiler.HtmlBridge.DomBridgeUtils.csproj" />
    <!--
      JSEAL: the contracts a migrated binding builds its JavaScript objects through. Contracts only —
      no engine provider, and deliberately so. This project's engine coupling is what the JSEAL work
      exists to count down (eng/jseal-budget.json), and it would be a poor trade to remove a
      Broiler.JS reference from a file and add a reference to the assembly that has one. The realm is
      obtained from whichever provider the host linked, through JsEngineRegistry; see
      DomBridge/Lifecycle.cs.
    -->

    <!-- The canvas 2D context rasterises into a Broiler.Graphics BBitmap and encodes it through the
         media image abstraction, which is what makes getImageData/toDataURL report real pixels. Both
         are dependency leaves here: Broiler.Graphics references only Broiler.Media.Image, and neither
         references this assembly, so there is no cycle. -->
    <!--
      Broiler.JavaScript.Globals is GONE from this project: the only thing the bridge used it for was
      JSGlobalStatic.StructuredClone, and structured clone is now IJsClone on the realm contract, so the
      reference moved to the provider that implements it. That is the shape every one of these should
      eventually take: an engine assembly reached by the provider and not by the bridge.
    -->
  </ItemGroup>

</Project>
