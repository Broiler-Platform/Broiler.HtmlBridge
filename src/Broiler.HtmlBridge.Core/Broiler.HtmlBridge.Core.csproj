<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.HtmlBridge</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Shared HtmlBridge DOM models, logging, scripting support, and lightweight bridge infrastructure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler" />
    <InternalsVisibleTo Include="Broiler.Browser.Core.Tests" />
    <!-- This component's own suite, which is where the bridge tests moved when the bridge
         left Broiler.Browser. The grant above stays: the browser keeps the tests that need
         its own host (page loading, the UI form controls, the render list). -->
    <InternalsVisibleTo Include="Broiler.HtmlBridge.Tests" />
    <InternalsVisibleTo Include="Broiler.Cli" />
    <InternalsVisibleTo Include="Broiler.Cli.Tests" />
    <InternalsVisibleTo Include="Broiler.DevConsole" />
    <InternalsVisibleTo Include="Broiler.DevConsole.Tests" />
    <InternalsVisibleTo Include="Broiler.HtmlBridge.Dom" />
    <!-- The bridge's static helpers moved out of Broiler.HtmlBridge.Dom and still use the same internals
         (JsEntryTrace, UrlResolver, Origin) that Dom does. -->
    <InternalsVisibleTo Include="Broiler.HtmlBridge.DomBridgeUtils" />
    <InternalsVisibleTo Include="Broiler.HtmlBridge.Scripting" />
    <!-- For UrlResolver alone. The VM engine resolves a dynamic import()'s specifier, and it has
         to resolve it the same way ScriptExtractionService resolved the keys it is matching
         against — two resolvers would make `./a.mjs` a module the map does not contain. -->
    <InternalsVisibleTo Include="Broiler.HtmlBridge.Scripting.Vm" />
    <InternalsVisibleTo Include="Broiler.Wpt" />
    <InternalsVisibleTo Include="Broiler.Wpt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Dom.Html" Version="0.1.0-preview.3" />
    <PackageReference Include="Broiler.Layout" Version="0.1.0-preview.3" />
    <PackageReference Include="Broiler.CSS.Dom" Version="0.1.0-preview.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(BroilerJsRoot)\Broiler.JS\Broiler.JavaScript.Engine\Broiler.JavaScript.Engine.csproj" />
    <!-- For Broiler.Layout.Net.BroilerUserAgent alone: the external-script fetcher here is one of
         the loaders that has to identify itself, and the engine gets to say what it is called in
         exactly one place. Broiler.Layout is the assembly every other loader — including the ones
         inside the Broiler.HTML submodule — already reaches, so putting the constant anywhere else
         buys this reference back somewhere worse. Nothing in Broiler.Layout's own closure references
         HtmlBridge, so it cannot cycle, and every consumer of this project already had Broiler.Layout
         in its closure. -->
  </ItemGroup>

</Project>
